# Copy to .env and fill in. Secrets stay here (or in your secret store), never in
# mirrors.yaml. SELF-HOSTING.md explains each one.

# Bearer key MCP clients send: `openssl rand -hex 32`
MCP_API_KEY=

# Where your browser reaches the server, for sign-in links.
PUBLIC_URL=http://127.0.0.1:8000

# MusicKit key from the Apple Developer portal (Certificates, IDs & Profiles → Keys).
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 contents: verbatim, with \n escapes, or just the base64 body.
APPLE_PRIVATE_KEY=

# Optional: a Spotify app (client credentials) for exact matching by ISRC.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Mirrors (off until you turn them on).
MIRRORS_ENABLED=false
# MIRRORS_FILE=/config/mirrors.yaml
# Or inline, on one line: MIRRORS_CONFIG={mirrors: [{name: rock, playlist_name: Rock, source: {type: webhook}}]}
# Enables POST /hooks/<secret> for pushed tracks: `openssl rand -hex 24`
WEBHOOK_SECRET=
